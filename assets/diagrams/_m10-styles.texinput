% Shared TikZ styles for the M10 memory-safety figures.
% Pulled in by each assets/diagrams/M10-*.tex via
%   \input{_m10-styles.texinput}
% Deliberately NOT named *.tex so build-diagrams.sh does not try to
% compile it standalone. Editing this file invalidates every figure
% (build-diagrams.sh compares outputs against the newest .texinput).
%
% Palette: same family as M01-roadmap.tex (greens for safe/OCaml,
% ambers for unsafe/attacker), plus memory-diagram roles.
\definecolor{fpfill}{HTML}{E8F0E6}     % safe / OCaml fill
\definecolor{fpedge}{HTML}{3A6C52}     % safe / OCaml edge
\definecolor{secfill}{HTML}{FBEED2}    % warning / C-side fill
\definecolor{secedge}{HTML}{B97A18}    % warning / C-side edge
\definecolor{labelgrey}{HTML}{444444}
\definecolor{stackfill}{HTML}{E3E9F2}  % stack memory
\definecolor{stackedge}{HTML}{4A6285}
\definecolor{heapfill}{HTML}{E8F0E6}   % live heap block (= fpfill)
\definecolor{heapedge}{HTML}{3A6C52}
\definecolor{freedfill}{HTML}{F9E4E1}  % freed / dangling / garbage
\definecolor{freededge}{HTML}{B0452F}
\definecolor{atkfill}{HTML}{FBEED2}    % attacker-controlled (= secfill)
\definecolor{atkedge}{HTML}{B97A18}

\usetikzlibrary{positioning,arrows.meta,patterns,decorations.pathreplacing,calc,fit}

\tikzset{
  m10/.style={font=\sffamily},
  % Generic rounded box (figure tiles, pipeline stages).
  box/.style={
    rounded corners=2.5pt, align=center, line width=0.6pt,
    inner sep=4pt, minimum height=9mm
  },
  safebox/.style={box, fill=fpfill, draw=fpedge, text=fpedge!75!black},
  warnbox/.style={box, fill=secfill, draw=secedge, text=secedge!75!black},
  greybox/.style={box, fill=white, draw=labelgrey!70, text=labelgrey},
  % Memory cells: one word / byte / field of a layout strip.
  cell/.style={
    draw=labelgrey!80, line width=0.5pt, align=center,
    minimum height=8mm, inner sep=2pt, font=\sffamily\small
  },
  stackcell/.style={cell, fill=stackfill, draw=stackedge},
  heapcell/.style={cell, fill=heapfill, draw=heapedge},
  freedcell/.style={cell, fill=freedfill, draw=freededge},
  atkcell/.style={cell, fill=atkfill, draw=atkedge},
  % Freed memory often additionally hatched:
  hatched/.style={pattern=north east lines, pattern color=freededge!60},
  % Arrows.
  flow/.style={-{Stealth[length=2.6mm]}, line width=0.8pt, draw=labelgrey},
  badflow/.style={flow, draw=freededge},
  goodflow/.style={flow, draw=fpedge},
  % Small annotation text.
  note/.style={font=\sffamily\footnotesize, text=labelgrey, align=center},
  badnote/.style={note, text=freededge},
  goodnote/.style={note, text=fpedge!75!black}
}
