# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Functional Programming with OCaml: NPTEL lecture sources and toolchain"
description:
  "Lecture sources, the static-site toolchain, and the in-browser OCaml/OxCaml notebooks for the NPTEL course 'Functional Programming with OCaml'. This package declares only the leaf dependencies needed to validate the lecture code blocks under ocaml-mdx."
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.2.0"}
  "mdx" {>= "2.4"}
  "qcheck"
  "qcheck-core"
  "ounit2"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
